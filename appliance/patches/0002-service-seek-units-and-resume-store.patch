+    def _resume_lookup(self, key):
+        """Return a stored resume position for ``key``, else 0.0."""
+        if not key:
+            return 0.0
+        entry = _resume_store_load().get(key)
+        if not isinstance(entry, dict):
+            return 0.0
+        try:
+            position = float(entry.get("position") or 0.0)
+            total = float(entry.get("total") or 0.0)
+        except (TypeError, ValueError):
+            return 0.0
+        if position < _RESUME_MIN_SECONDS:
+            return 0.0
+        if total > 0 and position >= total * _RESUME_NEAR_END_FRACTION:
+            return 0.0
+        return position
+
+    def _resume_persist(self, key, position, total):
+        """Store (or clear) the resume position for ``key``."""
+        if not key:
+            return
+        finished = total > 0 and position >= total * _RESUME_NEAR_END_FRACTION
+        items = _resume_store_load()
+        if position < _RESUME_MIN_SECONDS or finished:
+            # Nothing worth resuming — drop any stale entry so the next
+            # play starts clean instead of jumping near the end.
+            if items.pop(key, None) is None:
+                return
+        else:
+            items[key] = {
+                "position": round(position, 3),
+                "total": round(total, 3),
+                "updated": int(_time.time()),
+            }
+        _resume_store_save(items)
+
+    def _resume_persist_current(self, force=False):
+        """Persist the in-flight position, throttled unless ``force``."""
+        with self._state_lock:
+            key = self._resume_key
+            position = self._last_position
+            total = self._total_time
+            saved_at = self._resume_saved_at
+            if not force:
+                if _time.monotonic() - saved_at < _RESUME_SAVE_INTERVAL_SECONDS:
+                    return
+            self._resume_saved_at = _time.monotonic()
+        self._resume_persist(key, position, total)
