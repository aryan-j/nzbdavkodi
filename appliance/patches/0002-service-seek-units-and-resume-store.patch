+# Resume support.
+#
+# Kodi's native resume cannot work for these streams: every play mints a
+# fresh random proxy token (and the proxy's ephemeral port changes each
+# Kodi run), so Kodi keys its resume bookmark to a URL it will never see
+# again. Each play therefore leaves an orphaned bookmark and always starts
+# at 0. Instead of fighting that, the service keeps its own resume store
+# keyed by the release title, which is stable for a given episode/movie
+# file across plays *and* across Kodi restarts.
+_RESUME_STORE_FILE = "resume.json"
+# Below this many seconds there is nothing worth resuming.
+_RESUME_MIN_SECONDS = 30.0
+# At/after this fraction the item counts as finished, so the entry is
+# dropped rather than resuming a few seconds before the credits end.
+_RESUME_NEAR_END_FRACTION = 0.95
+# Bound the store so it cannot grow without limit.
+_RESUME_STORE_MAX_ITEMS = 200
+# Persist at most this often while playing (tick runs at ~1 Hz).
+_RESUME_SAVE_INTERVAL_SECONDS = 10.0
+
+
+def _resume_store_path():
+    """Return the on-disk path of the resume store."""
+    folder = xbmcvfs.translatePath(
+        "special://profile/addon_data/plugin.video.nzbdav/"
+    )
+    return os.path.join(folder, _RESUME_STORE_FILE)
+
+
+def _resume_store_load():
+    """Return the resume store's items mapping, or {} when unavailable."""
+    try:
+        with open(_resume_store_path(), "r", encoding="utf-8") as handle:
+            data = json.load(handle)
+    except (OSError, ValueError):
+        # Missing or corrupt store is not an error — resume is best-effort.
+        return {}
+    items = data.get("items") if isinstance(data, dict) else None
+    return items if isinstance(items, dict) else {}
+
+
+def _resume_store_save(items):
+    """Write the resume store atomically, trimming the oldest entries."""
+    if len(items) > _RESUME_STORE_MAX_ITEMS:
+        newest = sorted(
+            items.items(),
+            key=lambda item: item[1].get("updated", 0) if isinstance(item[1], dict) else 0,
+            reverse=True,
+        )
+        items = dict(newest[:_RESUME_STORE_MAX_ITEMS])
+    path = _resume_store_path()
+    temp_path = path + ".tmp"
+    try:
+        os.makedirs(os.path.dirname(path), exist_ok=True)
+        with open(temp_path, "w", encoding="utf-8") as handle:
+            json.dump({"version": 1, "items": items}, handle)
+        # Atomic replace so a crash mid-write cannot truncate the store.
+        os.replace(temp_path, path)
+    except OSError as error:
+        xbmc.log(
+            "NZB-DAV: Failed to write resume store: {}".format(error),
+            xbmc.LOGWARNING,
+        )
+
 
