+def _content_resume_key(params):
+    """Return a stable resume key for the content being played.
+
+    Keyed on TMDB identity rather than the release filename, so a stored
+    resume point still matches when a later play of the same episode/movie
+    picks a *different* release (different indexer result, re-download,
+    upgraded quality). Returns "" when identity is unknown, in which case
+    the service falls back to keying on the release title.
+    """
+    params = params or {}
+    media_type = str(params.get("type", "") or "").lower()
+    if media_type == "episode":
+        show_id = str(
+            params.get("show_tmdb_id", params.get("tmdb_id", "")) or ""
+        ).strip()
+        season = str(params.get("season", params.get("ep_season", "")) or "").strip()
+        episode = str(params.get("episode", params.get("ep_episode", "")) or "").strip()
+        if show_id and season and episode:
+            return "episode:{}:{}:{}".format(show_id, season, episode)
+        return ""
+    tmdb_id = str(params.get("tmdb_id", "") or "").strip()
+    if tmdb_id:
+        return "movie:{}".format(tmdb_id)
+    return ""
+
+
+def _signal_service_playback(home, play_url, title, params, resume_position=0.0):
+    """Publish this playback session to the background service.
+
+    ``nzbdav.active`` is written **last** so the service's 1 Hz tick can
+    never observe a half-populated session.
+    """
+    home.setProperty("nzbdav.stream_url", play_url)
+    home.setProperty("nzbdav.stream_title", title)
+    # Always write these two, clearing them when they do not apply: a stale
+    # value left by an earlier session that the service never consumed must
+    # not be inherited here, or this play could resume another item's
+    # position.
+    content_key = _content_resume_key(params)
+    if content_key:
+        home.setProperty("nzbdav.content_key", content_key)
+    else:
+        home.clearProperty("nzbdav.content_key")
+    if resume_position and resume_position > 0:
+        home.setProperty("nzbdav.resume_position", "{:.3f}".format(resume_position))
+    else:
+        home.clearProperty("nzbdav.resume_position")
+    home.setProperty("nzbdav.active", "true")
+
